modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["bash", "-c", "NODE_ENV=production node dist/index.cjs"]

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pk-coverage"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pk-chart-key"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pk-chart-key-e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "zoom-preference"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pk-catalog-coverage"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "pk-coverage"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/audit-pk-coverage.cjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "pk-chart-key"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/audit-pk-chart-key.cjs && npx vitest run tests/pk-chart-key.test.tsx"

[[workflows.workflow]]
name = "pk-chart-key-e2e"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh scripts/run-pk-chart-e2e.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "zoom-preference"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node --require tsx/cjs scripts/test-zoom-preference.cjs"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "pk-catalog-coverage"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/audit-pk-catalog.cjs"

[workflows.workflow.metadata]
isValidation = true

[agent]
integrations = ["javascript_mem_db:1.0.0", "javascript_database:1.0.0", "javascript_log_in_with_replit:1.0.0", "javascript_object_storage:1.0.0", "javascript_openai_ai_integrations:1.0.0", "javascript_paypal:1.0.0"]

[userenv]

[userenv.shared]
VITE_GA_MEASUREMENT_ID = "G-NETP832ZVN"
VITE_AUTH0_DOMAIN = "dev-5xq04wwsd1n7xn2n.us.auth0.com"
VITE_AUTH0_CLIENT_ID = "yOXwbImbiTsHffDetLDjqo38XhCKXtzU"
SES_SMTP_HOST = "email-smtp.us-east-2.amazonaws.com"
SES_SMTP_PORT = "587"
SES_FROM_EMAIL = "orders@reviveresearch.co"
ADMIN_EMAIL = "admin@reviveresearch.co"
AWS_REGION = "us-east-2"

[userenv.development]
PORT = "5000"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
