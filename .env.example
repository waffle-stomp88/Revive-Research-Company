# ─────────────────────────────────────────────────────────────────────────────
# Revive Research — environment variables
#
# Every name below is read somewhere in server/ or client/. Values marked
# SECRET live in Replit Secrets today and have to be copied across by hand;
# the rest are plain config that was in .replit [userenv].
#
# Copy to .env for local work, or paste into the host's environment panel.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required to boot ─────────────────────────────────────────────────────────
# The server will not start without these.

# SECRET. Supabase → Connect → Session pooler. Picks the driver by host:
# *.neon.tech uses the Neon WebSocket driver, anything else node-postgres.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# SECRET. Signs session cookies. Changing it logs everyone out — carry the
# existing value over rather than generating a new one.
SESSION_SECRET=

# Supabase project (auth only — application data lives in DATABASE_URL above).
SUPABASE_URL=https://jxlrrmwyzxxpxfrusdjl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # SECRET. Server-side only, never ship to the client.

# Set only if a host needs a fixed port; otherwise the platform provides PORT.
# PORT=5000
# DEPLOY_PORT=

# ── Public base URL ──────────────────────────────────────────────────────────
# Used for links in outbound email. Was REPLIT_DEPLOYMENT_URL / REPLIT_DEV_DOMAIN.
SITE_URL=https://reviveresearch.co

# ── Email — Amazon SES ───────────────────────────────────────────────────────
# Sends order confirmations, shipping notifications, back-in-stock alerts and
# contact-form confirmations. Domain verification lives in AWS, not Replit, so
# it keeps working once these are set.
SES_SMTP_HOST=email-smtp.us-east-2.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USERNAME=                    # SECRET
SES_SMTP_PASSWORD=                    # SECRET
SES_FROM_EMAIL=orders@reviveresearch.co
ADMIN_EMAIL=admin@reviveresearch.co

# ── SMS — Amazon SNS ─────────────────────────────────────────────────────────
# Back-in-stock alerts to subscribers who left a phone number.
AWS_ACCESS_KEY_ID=                    # SECRET
AWS_SECRET_ACCESS_KEY=                # SECRET
AWS_REGION=us-east-2
ADMIN_PHONE=

# ── Payments — PayPal ────────────────────────────────────────────────────────
# One-time order creation and capture. (Subscriptions were removed.)
PAYPAL_CLIENT_ID=                     # SECRET
PAYPAL_CLIENT_SECRET=                 # SECRET
PAYPAL_MODE=live                      # "live" for production, anything else = sandbox

# Shared secret for the custom POST /api/payments/webhook endpoint.
PAYMENT_WEBHOOK_SECRET=               # SECRET

# ── AI — OpenAI ──────────────────────────────────────────────────────────────
# Four endpoints, not three:
#   POST /api/chat                      support chatbot          gpt-4o-mini
#   POST /api/ai/synergy-analysis       stack synergy copy       gpt-4o-mini
#   POST /api/admin/pricing-suggestions pricing suggestions      gpt-4o-mini
#   POST /api/admin/coas/scan-image     COA parsing (vision)     gpt-4o
#
# The COA scanner sends images at detail:"high" through the full gpt-4o, which
# costs materially more per call than gpt-4o-mini. Worth watching once billing
# moves to your own account.
#
# On Replit these came from the platform's AI integration proxy, meaning usage
# was billed through Replit. Off Replit you need your own OpenAI account and
# key. Without it the server still boots — only the four AI endpoints fail.
OPENAI_API_KEY=                       # SECRET
# AI_INTEGRATIONS_OPENAI_API_KEY=     # Replit-only; leave unset elsewhere
# AI_INTEGRATIONS_OPENAI_BASE_URL=    # Replit-only; unset = api.openai.com

# ── Newsletter — Zoho Campaigns ──────────────────────────────────────────────
# Subscriber sync on waitlist and newsletter signup.
ZOHO_CLIENT_ID=                       # SECRET
ZOHO_CLIENT_SECRET=                   # SECRET
ZOHO_REFRESH_TOKEN=                   # SECRET
# ZOHO_RESTOCK_CLEANUP_DELAY_MS=90000

# ── Object storage ───────────────────────────────────────────────────────────
# COA PDFs and admin uploads. Still served by the Replit sidecar — these two
# are the Replit bucket paths and will change when storage is ported.
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# ── Feature flags ────────────────────────────────────────────────────────────
# EARLY_ACCESS_MODE is no longer read by the server — the only route that
# checked it was the Stripe checkout endpoint, now removed. The remaining
# early-access gate is a hardcoded constant in client/src/pages/checkout.tsx.
# Setting it here does nothing.

# ── Client build-time (VITE_*) ───────────────────────────────────────────────
# Inlined into the JS bundle at build time — public by definition. Never put a
# secret here. These must be present when `npm run build` runs, not at runtime.
VITE_SUPABASE_URL=https://jxlrrmwyzxxpxfrusdjl.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_PAYPAL_CLIENT_ID=
VITE_GA_MEASUREMENT_ID=G-NETP832ZVN
VITE_SOFT_GATE_ENABLED=

# ── Escape hatch ─────────────────────────────────────────────────────────────
# Set to 1 only if the database host is fronted by a private CA and TLS
# verification fails. The Supabase pooler uses a public certificate, so this
# should stay unset.
# DATABASE_SSL_NO_VERIFY=1
